-- Line items, ordered by orderIdx within an invoice. Replaced wholesale on every invoice write.
CREATE TABLE invoiceItemRow (
    invoiceId TEXT NOT NULL,
    orderIdx INTEGER NOT NULL,
    description TEXT NOT NULL,
    hsnSac TEXT,
    quantity TEXT NOT NULL,
    unitPrice INTEGER NOT NULL,
    taxRatePercent TEXT NOT NULL,
    lineTotal INTEGER NOT NULL,
    taxAmount INTEGER NOT NULL,
    PRIMARY KEY (invoiceId, orderIdx)
);

forInvoice:
SELECT * FROM invoiceItemRow WHERE invoiceId = ? ORDER BY orderIdx ASC;

-- For the invoice list: how many lines each invoice has, and what its first line is. One pass over
-- the items table instead of loading every invoice's lines just to count them.
summaries:
SELECT invoiceId,
       COUNT(*) AS itemCount,
       (SELECT first.description FROM invoiceItemRow AS first
        WHERE first.invoiceId = item.invoiceId
        ORDER BY first.orderIdx ASC LIMIT 1) AS firstDescription
FROM invoiceItemRow AS item
GROUP BY invoiceId;

insertItem:
INSERT OR REPLACE INTO invoiceItemRow(
    invoiceId, orderIdx, description, hsnSac, quantity, unitPrice, taxRatePercent, lineTotal, taxAmount
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteForInvoice:
DELETE FROM invoiceItemRow WHERE invoiceId = ?;

clear:
DELETE FROM invoiceItemRow;
