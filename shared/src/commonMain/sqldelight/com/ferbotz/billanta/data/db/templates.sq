-- Template catalogue (mirror of GET /templates) + compiled render-tree cache.
-- A (templateId, version) pair is immutable server-side, so compiled JSON is cached forever.
CREATE TABLE templateRow (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    category TEXT,
    thumbnailUrl TEXT,
    isPremium INTEGER NOT NULL DEFAULT 0,
    currentVersion INTEGER NOT NULL,
    checksum TEXT NOT NULL,
    orderIdx INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE compiledTemplateRow (
    templateId TEXT NOT NULL,
    version INTEGER NOT NULL,
    checksum TEXT NOT NULL,
    json TEXT NOT NULL,
    fetchedAtMillis INTEGER NOT NULL,
    PRIMARY KEY (templateId, version)
);

upsertTemplate:
INSERT OR REPLACE INTO templateRow(id, name, category, thumbnailUrl, isPremium, currentVersion, checksum, orderIdx)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

listTemplates:
SELECT * FROM templateRow ORDER BY orderIdx ASC, name ASC;

templateById:
SELECT * FROM templateRow WHERE id = ?;

deleteTemplatesNotIn:
DELETE FROM templateRow WHERE id NOT IN :ids;

compiledFor:
SELECT * FROM compiledTemplateRow WHERE templateId = ? AND version = ?;

upsertCompiled:
INSERT OR REPLACE INTO compiledTemplateRow(templateId, version, checksum, json, fetchedAtMillis)
VALUES (?, ?, ?, ?, ?);

clearTemplates:
DELETE FROM templateRow;

clearCompiled:
DELETE FROM compiledTemplateRow;
