-- Reusable products/services. Built automatically from the line items people actually invoice,
-- then offered back when adding the next item. Sync columns mirror customerRow so the push/replay
-- logic is identical once the backend endpoints land (contract request APP-002).
CREATE TABLE productRow (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    -- Case/space-insensitive key used to recognise "the same product" typed again.
    nameKey TEXT NOT NULL,
    hsnSac TEXT,
    unitPrice INTEGER NOT NULL,
    taxRatePercent TEXT NOT NULL,
    unit TEXT,
    usageCount INTEGER NOT NULL DEFAULT 1,
    lastUsedAtMillis INTEGER NOT NULL,
    createdAtMillis INTEGER,
    updatedAtMillis INTEGER NOT NULL,
    dirty INTEGER NOT NULL DEFAULT 0,
    isDeleted INTEGER NOT NULL DEFAULT 0,
    isSynced INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX idx_product_name_key ON productRow(nameKey);
CREATE INDEX idx_product_recent ON productRow(lastUsedAtMillis);

upsert:
INSERT OR REPLACE INTO productRow(
    id, name, nameKey, hsnSac, unitPrice, taxRatePercent, unit, usageCount, lastUsedAtMillis,
    createdAtMillis, updatedAtMillis, dirty, isDeleted, isSynced
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

byId:
SELECT * FROM productRow WHERE id = ? AND isDeleted = 0;

byNameKey:
SELECT * FROM productRow WHERE nameKey = ? AND isDeleted = 0;

-- Most-used first, then most-recent: the thing you invoice every month sits at the top.
list:
SELECT * FROM productRow
WHERE isDeleted = 0
  AND (:q = '' OR name LIKE '%' || :q || '%')
ORDER BY usageCount DESC, lastUsedAtMillis DESC
LIMIT :limit;

dirtyRows:
SELECT * FROM productRow WHERE dirty = 1;

markSynced:
UPDATE productRow SET dirty = 0, isSynced = 1 WHERE id = ? AND updatedAtMillis = ?;

softDelete:
UPDATE productRow SET isDeleted = 1, dirty = 1, updatedAtMillis = ? WHERE id = ?;

hardDelete:
DELETE FROM productRow WHERE id = ?;

clear:
DELETE FROM productRow;
