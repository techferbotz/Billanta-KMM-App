-- Per-user app settings. Single row (localId is always 1). Server auto-creates defaults.
CREATE TABLE settingsRow (
    localId INTEGER NOT NULL PRIMARY KEY,
    defaultCurrency TEXT NOT NULL,
    defaultTaxPercent TEXT NOT NULL,
    invoiceNumberPrefix TEXT NOT NULL,
    nextInvoiceNumber INTEGER NOT NULL,
    defaultTemplateId TEXT,
    defaultNotes TEXT,
    dirty INTEGER NOT NULL DEFAULT 0,
    updatedAtMillis INTEGER NOT NULL DEFAULT 0
);

get:
SELECT * FROM settingsRow WHERE localId = 1;

upsert:
INSERT OR REPLACE INTO settingsRow(
    localId, defaultCurrency, defaultTaxPercent, invoiceNumberPrefix, nextInvoiceNumber,
    defaultTemplateId, defaultNotes, dirty, updatedAtMillis
) VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?);

markClean:
UPDATE settingsRow SET dirty = 0 WHERE localId = 1;

clear:
DELETE FROM settingsRow;
